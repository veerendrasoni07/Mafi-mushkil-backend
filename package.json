{
  "name": "mafi-mushkil-backend",
  "version": "1.0.0",
  "description": "Backend API for Mafi Mushkil Service Management App",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "node --test --test-concurrency=1 dist/tests/**/*.test.js || tsx --test --test-concurrency=1 src/tests/**/*.test.ts",
    "seed": "tsx src/database/seed.ts",
    "bootstrap:admin": "tsx src/scripts/bootstrap-admin.ts"
  },
  "keywords": [
    "service",
    "management",
    "express",
    "mongoose"
  ],
  "author": "Mafi Mushkil Team",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "nodemailer": "^10.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
